<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <title>Ma capitainerie</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f4f6f9;
        color: #1a2b4c;
        max-width: 600px;
        margin: 2rem auto;
      }

      li {
        background: white;
        padding: 0.5rem;
        margin: 0.3rem 0;
        border-left: 4px solid #d62828;
      }

      button {
        background: #1a2b4c;
        color: white;
        border: none;
        padding: 0.4rem;
      }

      form[action="/depart"] button {
        background: #d62828;
      }
    </style>
</head>
<body>
    <h1>Ma capitainerie</h1>

    <p>
      <%= stats.nombre %> navire<%= stats.nombre > 1 ? "s" : "" %> à quai —
      <%= stats.metres %> m de quai occupés
      <% if (stats.majoritaire !== null) { %>
        — type majoritaire : <%= stats.majoritaire %>
      <% } %>
    </p>

    <% if (filtreType !== null) { %>
      <p><a href="/">← Tout le port</a></p>
    <% } %>

    <ul>
      <% for (const n of navires) { %>
        <li>
          <strong><%= n.nom %></strong>
          — <a href="/type/<%= n.type %>"><%= n.type %></a>, ponton <%= n.ponton %>, <%= n.longueur %> m
          <% const jours = joursAQuai(n.arriveLe); %>
          <% if (jours === 0) { %>
            (arrivé aujourd'hui)
          <% } else { %>
            (à quai depuis <%= jours %> jour<%= jours > 1 ? "s" : "" %>)
          <% } %>
          <form method="POST" action="/depart" style="display: inline;">
            <input type="hidden" name="index" value="<%= n.index %>">
            <button type="submit">⚓ Lever l'ancre</button>
          </form>
        </li>
      <% } %>
    </ul>

    <h2>Enregistrer une arrivée</h2>
    <form method="POST" action="/accoster">
      <label>Nom du navire
        <input name="nom" required>
      </label>

      <label>Type
        <select name="type">
          <option>Voilier</option>
          <option>Yacht</option>
          <option>Chalutier</option>
          <option>Catamaran</option>
        </select>
      </label>

      <label>Ponton
        <select name="ponton">
          <option>A</option>
          <option>B</option>
          <option>C</option>
        </select>
      </label>

      <label>Longueur (mètres)
        <input name="longueur" type="number" min="1" required>
      </label>

      <button type="submit">Enregistrer l'accostage</button>