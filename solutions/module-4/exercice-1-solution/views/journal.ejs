<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Journal de bord</title>
  <style>
    body { font-family: sans-serif; max-width: 600px; margin: 2rem auto; }
    li { margin: 0.3rem 0; }
  </style>
</head>
<body>
  <!-- Étape 3a : le titre -->
  <h1><%= titre %></h1>

  <!-- Étape 3b : la liste -->
  <ul>
    <% for (const s of sessions) { %>
      <li><%= s.date %> — <%= s.sujet %> (<%= s.minutes %> min)</li>
    <% } %>
  </ul>

  <!-- Étape 3c : le cas "liste vide" -->
  <% if (sessions.length === 0) { %>
    <p>Aucune session ici pour l'instant.</p>
  <% } %>

  <!-- Étape 5 (bonus) : le total, calculé côté serveur -->
  <p>Total : <%= total %> minutes</p>
</body>
</html>
